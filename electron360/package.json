{
  "name": "electron360",
  "version": "1.0.0",
  "description": "Sistema de gestión para taller de reparación de tecnología",
  "main": "electron/main.js",
  "author": "Electron360",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "lucide-react": "^0.446.0",
    "pdfmake": "^0.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.electron360.taller",
    "productName": "Electron360",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "buildResources": "build" }
  }
}
